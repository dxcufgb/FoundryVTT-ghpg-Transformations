<section class="classes pills-lg transformation-features-pills">
    <div class="class pill-lg transformation-features-pill" style="--underlay: url('{{ background }}');">
        <div class="icons">
            <img class="gold-icon item-tooltip" src="{{ img }}" alt="{{ name }}" data-action="showDocument"
                 data-uuid="{{ uuid }}"
                 data-tooltip="&lt;section class=&quot;loading&quot; data-uuid=&quot;{{ uuid }}&quot;&gt;&lt;i class=&quot;fas fa-spinner fa-spin-pulse&quot;&gt;&lt;/i&gt;&lt;/section&gt;"
                 data-tooltip-class="dnd5e2 dnd5e-tooltip item-tooltip themed theme-light"
                 data-tooltip-direction="LEFT">
        </div>
        <div class="name-stacked">
            <div class="title">{{ name }}</div>
            <div class="subtitle">{{ subtitle }}</div>
        </div>
        <div class="level">
            <span>{{ stage }}</span>
        </div>
    </div>
</section>
