            "name": "Paralyzing Touch Prone On Save",
            "command": "// Paralyzing Touch: failed save -> Paralyzed (applied by midi from the activity effects),\n// successful save -> Prone instead (applied here, only to the creatures that saved).\nconst { workflow, saveUuids } = args[0]\nif (!saveUuids?.length) return\nconst prone = workflow.item?.effects?.find(effect => effect.statuses?.has(\"prone\"))\nif (!prone || typeof globalThis.DAE?.doActivityEffects !== \"function\") return\nawait globalThis.DAE.doActivityEffects(workflow.activity, true, saveUuids, [prone.uuid], {\n    origin: workflow.item.uuid,\n    itemCardUuid: workflow.itemCardUuid,\n    metaData: { flags: { dae: { transfer: false } } }\n})"
